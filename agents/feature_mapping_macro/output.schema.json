{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/feature-mapping-macro/output.schema.json",
  "title": "FeatureMappingMacroOutput",
  "description": "v0.10.23 — feature_mapping_macro_node 의 LLM 출력 schema. 자기 담당 report_type 1종 (market_context_swot) 의 매크로 부분 feature × candidate × URL 커버리지 매핑. candidate_id='macro' 단일 키. v0.10.27 통합 노드 도입 시 활용.",
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "description": "본 source-type (macro) 가 담당하는 market_context_swot 의 매크로 active feature 목록.",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report_type", "feature_id", "feature_name", "description", "priority", "candidate_coverage"],
        "properties": {
          "report_type": {
            "type": "string",
            "enum": ["market_context_swot"],
            "description": "macro 노드는 market_context_swot 의 매크로 부분만 담당."
          },
          "feature_id":   { "type": "string", "pattern": "^feat_" },
          "feature_name": { "type": "string", "minLength": 2 },
          "description":  { "type": "string", "minLength": 10 },
          "priority":     { "type": "string", "enum": ["high", "medium", "low"] },
          "candidate_coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "coverage", "existing_urls", "additional_urls"],
              "properties": {
                "candidate_id": { "type": "string", "description": "macro 노드는 항상 'macro' 단일 키 (v0.10.22 D32)." },
                "coverage":     { "type": "string", "enum": ["sufficient", "partial", "not_found"] },
                "existing_urls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": {
                      "url":            { "type": "string", "format": "uri" },
                      "relevance_note": { "type": "string" },
                      "origin":         { "type": "string", "enum": ["macro_search"] },
                      "source_tier":    { "type": "string", "enum": ["official_statistics", "news_supplement"], "description": "v0.10.22 — Tier 1·2·3 공식 통계 vs Stage 2 뉴스 보강" },
                      "tier_group":     { "type": "string", "enum": ["tier1_statistics", "tier2_policy", "tier3_dynamic", "news"], "description": "v0.10.22 — 세부 Tier 분류" }
                    }
                  }
                },
                "additional_urls": {
                  "type": "array",
                  "description": "추가 탐색 후보. 공식 통계 도메인 (kosis.kr·ecos.bok.or.kr·fsc.go.kr 등) 또는 동적 화이트리스트(macro_data_sources) + 뉴스 보강 (yna.co.kr 등). coverage=sufficient 시 빈 배열. feature 당 최대 2개.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "rationale", "url_confidence"],
                    "properties": {
                      "url":            { "type": "string", "format": "uri" },
                      "rationale":      { "type": "string" },
                      "url_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
