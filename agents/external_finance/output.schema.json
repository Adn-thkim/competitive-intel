{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "unavailable", "notes"],
  "properties": {
    "metrics": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["cid", "entity", "metric", "label", "value", "unit", "qualifier", "as_of", "as_of_kind", "basis", "scope", "doc_id", "quote"],
      "properties": {
        "cid": {"type": ["string", "null"]}, "entity": {"type": "string"},
        "metric": {"enum": ["가입자 수", "계좌 수", "카드 발급 수", "이용 고객 수", "외화예금 잔액", "누적 환전액", "누적 이용액", "기능 이용자 수", "기타"]},
        "label": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"},
        "qualifier": {"enum": ["약", "이상", "돌파", "미만", "정확"]},
        "as_of": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "as_of_kind": {"enum": ["기준일", "게시일"]},
        "basis": {"enum": ["누적", "시점 잔액", "기간 합계"]}, "scope": {"type": "string"},
        "doc_id": {"type": "string"}, "quote": {"type": "string", "maxLength": 160}}}},
    "unavailable": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["cid", "metric", "note"],
      "properties": {"cid": {"type": ["string", "null"]}, "metric": {"type": "string"}, "note": {"type": "string"}}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
