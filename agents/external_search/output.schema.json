{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["docs", "searches", "gaps"],
  "properties": {
    "docs": {"type": "array", "maxItems": 40, "items": {"type": "object", "additionalProperties": false,
      "required": ["url", "title", "publisher", "published_at", "cid_hint", "excerpts"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "title": {"type": "string"}, "publisher": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "cid_hint": {"type": ["string", "null"]},
        "excerpts": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "maxLength": 400}}}}},
    "searches": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  }
}
