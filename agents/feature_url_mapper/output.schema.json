{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/feature-url-mapper/output.schema.json",
  "title": "FeatureUrlMapperOutput",
  "description": "v0.10: domain_taxonomy.report_config 기반 report_type × feature × candidate URL 커버리지 매핑.\n\n처리 흐름:\n  1. report_config[report_type].features에서 비교할 feature 목록을 수신한다 (LLM이 직접 생성하지 않음).\n  2. 각 feature × candidate 조합마다 existing_urls(official_source_resolver + Brave 검색 결과)로 충분한지 평가한다.\n  3. 부족하면 도메인 내 sub-page 또는 추가 후보 URL을 additional_urls로 제안한다 (HTTP 검증은 노드가 수행).",
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "description": "report_config의 모든 active 리포트의 feature를 합친 목록. report_type 필드로 D6 카드 그룹핑 가능.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_type",
          "feature_id",
          "feature_name",
          "description",
          "priority",
          "candidate_coverage"
        ],
        "properties": {
          "report_type": {
            "type": "string",
            "description": "v0.10 D4 enum 7종 중 하나. 본 feature가 기여하는 리포트.",
            "enum": [
              "comparison_matrix",
              "reaction_insight",
              "marketing_social",
              "battlecard",
              "positioning_map",
              "market_context_swot",
              "executive_summary"
            ]
          },
          "feature_id": {
            "type": "string",
            "description": "feature 고유 식별자. 반드시 feat_ 접두사를 가진다. taxonomy feature ID에 feat_ 접두사를 붙인 값. 예: 'transaction_fee_rate' → 'feat_transaction_fee_rate'",
            "pattern": "^feat_"
          },
          "feature_name": {
            "type": "string",
            "description": "사용자에게 표시할 분석 항목 한국어 명칭. taxonomy의 feature_labels에서 가져온다.",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "description": "이 항목이 무엇을 비교하는지 1~2문장 설명.",
            "minLength": 10
          },
          "priority": {
            "type": "string",
            "description": "비교 분석에서의 중요도. high: 핵심 / medium: 보조 / low: 참고.",
            "enum": ["high", "medium", "low"]
          },
          "candidate_coverage": {
            "type": "array",
            "description": "각 후보(own_*, comp_*, func_*)별 이 feature에 대한 URL 커버리지.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "coverage",
                "existing_urls",
                "additional_urls"
              ],
              "properties": {
                "candidate_id": { "type": "string" },
                "coverage": {
                  "type": "string",
                  "description": "existing_urls(official_source + Brave 검색)만으로 본 feature를 수집 가능한지 평가.\n  sufficient — 기존 URL에 충분히 포함됨\n  partial    — 일부 있으나 전용 sub-page 가능성 높음\n  not_found  — 추가 탐색 필요",
                  "enum": ["sufficient", "partial", "not_found"]
                },
                "existing_urls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": {
                      "url":            { "type": "string", "format": "uri" },
                      "relevance_note": { "type": "string" },
                      "origin":         { "type": "string", "enum": ["official_source", "brave_search"] }
                    }
                  }
                },
                "additional_urls": {
                  "type": "array",
                  "description": "추가 탐색 후보. existing_url의 sub-path 또는 동일 도메인 내 전용 페이지 우선. coverage=sufficient이면 빈 배열 []. feature-candidate 쌍마다 최대 2개.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "rationale", "url_confidence"],
                    "properties": {
                      "url":            { "type": "string", "format": "uri" },
                      "rationale":      { "type": "string" },
                      "url_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
