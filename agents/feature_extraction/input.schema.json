{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/feature-extraction/input.schema.json",
  "title": "FeatureExtractionAgentInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "resolution_targets",
    "official_sources"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "resolution_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_type",
          "brand",
          "product_name",
          "category"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "own_product",
              "competitor_candidate"
            ]
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "official_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "target_type",
          "brand",
          "product_name",
          "source_type",
          "url",
          "domain",
          "page_title",
          "rationale",
          "confidence",
          "needs_validation"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "own_product",
              "competitor_candidate"
            ]
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official_site",
              "official_product_page",
              "official_help_center",
              "official_pricing_page",
              "official_faq"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "page_title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_validation": {
            "type": "boolean"
          }
        }
      }
    },
    "source_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "url",
          "verdict",
          "positive_signals",
          "negative_signals",
          "recommended_use",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "verified",
              "likely_official",
              "ambiguous",
              "rejected"
            ]
          },
          "positive_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "negative_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_use": {
            "type": "string",
            "enum": [
              "primary_reference",
              "secondary_reference",
              "do_not_use"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "normalization_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feature_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "category_hint": {
          "type": "string",
          "minLength": 1
        },
        "preferred_unknown_value": {
          "type": "string",
          "enum": [
            "unknown",
            "not_found",
            "requires_manual_check"
          ]
        },
        "preserve_source_evidence": {
          "type": "boolean"
        }
      }
    },
    "extraction_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_sources_per_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "include_help_center": {
          "type": "boolean"
        },
        "include_pricing_pages": {
          "type": "boolean"
        },
        "include_ambiguous_sources": {
          "type": "boolean"
        }
      }
    }
  }
}
