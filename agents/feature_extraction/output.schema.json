{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/feature-extraction/output.schema.json",
  "title": "FeatureExtractionAgentOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project_id",
    "extraction_targets",
    "product_profiles",
    "normalized_feature_schema",
    "normalized_features",
    "unresolved_targets",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_type",
          "brand",
          "product_name",
          "category",
          "selected_source_ids"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "own_product",
              "competitor_candidate"
            ]
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "selected_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "product_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_type",
          "brand",
          "product_name",
          "category",
          "source_ids",
          "source_urls",
          "product_summary",
          "raw_profile",
          "coverage_status",
          "confidence",
          "needs_manual_review"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "own_product",
              "competitor_candidate"
            ]
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          },
          "product_summary": {
            "type": "string",
            "minLength": 1
          },
          "raw_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "features",
              "fees",
              "benefits",
              "constraints"
            ],
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "fees": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "benefits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "eligibility": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "usage_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "evidence_points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "url",
                "claim",
                "evidence_type",
                "support_level"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "minLength": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_type": {
                  "type": "string",
                  "enum": [
                    "feature",
                    "fee",
                    "benefit",
                    "constraint",
                    "eligibility",
                    "usage_scope"
                  ]
                },
                "support_level": {
                  "type": "string",
                  "enum": [
                    "explicit",
                    "partial",
                    "inferred"
                  ]
                }
              }
            }
          },
          "coverage_status": {
            "type": "string",
            "enum": [
              "sufficient",
              "partial",
              "insufficient"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_manual_review": {
            "type": "boolean"
          }
        }
      }
    },
    "normalized_feature_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "normalized_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_type",
          "product_name",
          "schema_version",
          "normalized_features",
          "normalization_notes"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "own_product",
              "competitor_candidate"
            ]
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "normalized_features": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "card_type",
              "supported_currencies",
              "exchange_fee",
              "overseas_payment_fee",
              "atm_withdrawal",
              "recharge_method",
              "app_linkage",
              "travel_benefits",
              "eligibility",
              "major_constraints",
              "source_coverage"
            ],
            "properties": {
              "card_type": {
                "type": "string",
                "minLength": 1
              },
              "supported_currencies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exchange_fee": {
                "type": "string",
                "minLength": 1
              },
              "overseas_payment_fee": {
                "type": "string",
                "minLength": 1
              },
              "atm_withdrawal": {
                "type": "string",
                "minLength": 1
              },
              "recharge_method": {
                "type": "string",
                "minLength": 1
              },
              "app_linkage": {
                "type": "string",
                "minLength": 1
              },
              "travel_benefits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "eligibility": {
                "type": "string",
                "minLength": 1
              },
              "major_constraints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_coverage": {
                "type": "string",
                "enum": [
                  "sufficient",
                  "partial",
                  "insufficient"
                ]
              }
            }
          },
          "normalization_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unresolved_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "brand",
          "product_name",
          "reason",
          "suggested_next_step"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "suggested_next_step": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
