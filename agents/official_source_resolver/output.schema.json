{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/official-source-resolver/output.schema.json",
  "title": "OfficialSourceResolverAgentOutput",
  "description": "자사·경쟁사 공식 URL 및 기능적 대안 참조 출처 탐색 결과.\n\nresolution_type 분기 (Strategy 1):\n  'official'   — own_* / comp_*: 브랜드 상품. 단일 공식 URL 후보 목록 반환.\n  'reference'  — func_*: 공식 사이트 없음. 기관·정책 레퍼런스 URL 목록 반환.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolutions"],
  "properties": {
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "title": "OfficialResolution",
            "description": "own_* 또는 comp_* 항목 — 공식 URL 후보 목록을 반환한다.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "resolution_type",
              "brand",
              "product_name",
              "candidate_urls"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "state의 candidate_id와 동일. own_* 또는 comp_* 접두사.",
                "pattern": "^(own_|comp_)"
              },
              "resolution_type": {
                "type": "string",
                "const": "official"
              },
              "brand": {
                "type": "string",
                "minLength": 1
              },
              "product_name": {
                "type": "string",
                "minLength": 1
              },
              "candidate_urls": {
                "type": "array",
                "description": "신뢰도 높은 순 URL 후보. HTTP 검증은 노드가 수행한다.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["url", "url_confidence", "rationale"],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "url_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "이 URL이 실제 공식 페이지일 가능성 (LLM 사전지식 기반)"
                    },
                    "rationale": {
                      "type": "string",
                      "description": "이 URL을 제안한 이유"
                    }
                  }
                }
              }
            }
          },
          {
            "title": "ReferenceResolution",
            "description": "func_* 항목 — 공식 사이트 없음. 기관·정책 레퍼런스 출처를 반환한다.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "resolution_type",
              "method_name",
              "provider_type",
              "reference_sources",
              "note"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "description": "state의 candidate_id와 동일. 반드시 func_* 접두사.",
                "pattern": "^func_"
              },
              "resolution_type": {
                "type": "string",
                "const": "reference"
              },
              "method_name": {
                "type": "string",
                "minLength": 1
              },
              "provider_type": {
                "type": "string",
                "minLength": 1
              },
              "reference_sources": {
                "type": "array",
                "description": "신뢰할 수 있는 기관·정책 참조 페이지 목록. 출처가 전혀 없으면 빈 배열.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["url", "source_name", "description"],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "source_name": {
                      "type": "string",
                      "description": "출처 기관명. 예: '금융감독원', '한국은행', '우정사업본부'"
                    },
                    "description": {
                      "type": "string",
                      "description": "이 출처가 참조 근거로 적합한 이유"
                    }
                  }
                }
              },
              "note": {
                "type": "string",
                "description": "공식 URL 부재 이유 및 레퍼런스 선택 근거를 1~2문장으로 설명"
              }
            }
          }
        ]
      }
    }
  }
}
