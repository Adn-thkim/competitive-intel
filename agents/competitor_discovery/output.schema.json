{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/competitor-discovery/output.schema.json",
  "title": "CompetitorDiscoveryAgentOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project_id",
    "own_product_summary",
    "competition_axes",
    "competitor_candidates",
    "functional_competitors",
    "excluded_or_deferred",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "own_product_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_position",
        "primary_use_cases"
      ],
      "properties": {
        "market_position": {
          "type": "string",
          "minLength": 1
        },
        "primary_use_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "competition_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "competitor_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "brand",
          "product_name",
          "competition_type",
          "category",
          "why_competitor",
          "evidence_summary",
          "confidence",
          "needs_validation"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "competition_type": {
            "type": "string",
            "enum": [
              "direct",
              "indirect",
              "substitute"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "why_competitor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_validation": {
            "type": "boolean"
          }
        }
      }
    },
    "functional_competitors": {
      "type": "array",
      "description": "브랜드 경쟁사가 아닌 전통적·기능적 대안 수단 목록. 별도 섹션으로 UI에 출력되며 경쟁사 선택 범위(1-10개)에 포함된다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "method_name",
          "provider_type",
          "category",
          "why_alternative",
          "confidence"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "description": "식별자. 반드시 'func_' 접두사로 시작. 예: func_local_atm",
            "pattern": "^func_",
            "minLength": 6
          },
          "method_name": {
            "type": "string",
            "description": "대안 수단의 명칭. 예: '현지 ATM 현금 인출', '은행 창구 환전'",
            "minLength": 1
          },
          "provider_type": {
            "type": "string",
            "description": "제공 주체 유형. 예: '시중은행', '공항 환전소', '현지 ATM', '우체국'",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "why_alternative": {
            "type": "array",
            "description": "자사 상품의 대안으로 고려되는 이유",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "description": "이 대안이 실제 사용자의 선택지로 고려될 가능성 (0-1)",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "excluded_or_deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
