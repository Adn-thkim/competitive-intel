{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/comparison-matrix/output.schema.json",
  "title": "ComparisonMatrixAgentOutput",
  "description": "코드가 구성한 feature_table을 입력받아 LLM이 산출하는 판정 부분 (CM-D1). 표 수치는 재생성하지 않는다. 설계: docs/design/comparison_matrix_node_design.md §5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["zone_summary", "harvey_balls", "use_case_weights", "evaluation_score", "score_rationale", "warnings"],
  "properties": {
    "zone_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winning", "battling", "losing", "overall_comment"],
      "properties": {
        "winning":  { "$ref": "#/$defs/zoneItems" },
        "battling": { "$ref": "#/$defs/zoneItems" },
        "losing":   { "$ref": "#/$defs/zoneItems" },
        "overall_comment": {
          "type": "string",
          "maxLength": 600,
          "description": "own 관점 종합 코멘트. 표에 없는 사실 인용 금지."
        }
      }
    },
    "harvey_balls": {
      "type": "array",
      "description": "정성 feature(value_numeric 없는 열) 한정 5단계(0~4) 판정. 정량 feature는 포함 금지.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "legend", "ratings"],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^feat_" },
          "legend": {
            "type": "string",
            "maxLength": 200,
            "description": "각 단계의 의미 범례 (예: '4=전 통화 지원, 2=주요 통화만'). 필수 — Harvey Balls 규약"
          },
          "ratings": {
            "type": "object",
            "description": "candidate_id → 0(없음)~4(완전). 미확인 셀 candidate는 키 자체를 생략",
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        }
      }
    },
    "use_case_weights": {
      "type": "array",
      "description": "입력에 action_lens가 있을 때만 산출. 없으면 빈 배열.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["use_case", "weights"],
        "properties": {
          "use_case": { "type": "string" },
          "weights": {
            "type": "object",
            "description": "feature_id → 가중치 0~1 (합계 1 권장)",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "evaluation_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Rubric §2-1 루브릭 자체 평가"
    },
    "score_rationale": {
      "type": "string",
      "maxLength": 300,
      "description": "점수 산정 근거 (어느 요건 충족/미충족)"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 },
      "description": "AP-1~AP-7 위반 후보 등 주의 사항"
    }
  },
  "$defs": {
    "zoneItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "rationale"],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^feat_" },
          "rationale": {
            "type": "string",
            "maxLength": 300,
            "description": "판정 근거 — 표의 display 값 인용. 표에 없는 사실 금지"
          }
        }
      }
    }
  }
}
