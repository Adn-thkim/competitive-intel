# ============================================================
# competitive-intel 환경변수 설정 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
# .env 파일은 절대 git에 커밋하지 마세요.
# ============================================================


# ── Claude API ───────────────────────────────────────────────
# ProductIdResolver, InsightReportAgent 등 API 직접 호출에 사용됩니다.
# https://console.anthropic.com 에서 발급하세요.
ANTHROPIC_API_KEY=sk-ant-...


# ── Claude Code CLI ──────────────────────────────────────────
# ClaudeCodeCliAnalyzer(subprocess)에서 사용하는 모델 및 타임아웃.
# ⚠️ CLI는 temperature 설정을 지원하지 않습니다.
CLI_MODEL=claude-sonnet-4-6
CLI_TIMEOUT=120

# Claude API 직접 호출 시 사용할 모델 (temperature=0 결정론적 처리)
API_MODEL=claude-sonnet-4-6


# ── 캐시 ─────────────────────────────────────────────────────
# 기본값: <프로젝트루트>/data/cache/
# 절대 경로 또는 상대 경로 모두 사용 가능합니다.
# CACHE_DIR=/tmp/yt_analysis_cache

# 분석 캐시 유효 기간(시간). 초과 시 재실행 및 덮어쓰기.
ANALYSIS_CACHE_TTL_HOURS=48


# ── Brave Search API ─────────────────────────────────────────
# Phase 1 URL 재탐색(검색 기반)에 사용됩니다.
# https://api.search.brave.com | 무료 크레딧 $5/월 (Search 플랜: ~1,000 쿼리 무료)
BRAVE_SEARCH_API_KEY=BSAv...


# ── LangGraph ────────────────────────────────────────────────
# CompetitorDiscoveryAgent가 반환할 후보 수 제한
COMPETITOR_CANDIDATE_MIN=5
COMPETITOR_CANDIDATE_MAX=15
